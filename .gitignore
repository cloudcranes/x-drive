# 运行时与开发产物：不该进仓库
.venv/
# faststart 的临时目录（STATE_DIR/work，与仓库同目录时会误入）
work/
faststart/
# 大文件中间产物：目录级规则管不住「临时目录恰好在别处」的情况，
# 而 5GB 的 .part 一旦进仓库就再也删不干净（对象会留在 pack 里）。
*.part
*.faststart.mp4
*.faststart.tmp
.data/
.dsh-progress/
__pycache__/
*.py[cod]
.pytest_cache/
data/
.env
.env.local
