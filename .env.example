# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 Telegram user id；留空 = 拒绝所有人。先给 bot 发条消息即可看到自己的 id
ALLOWED_USER_IDS=

# ── 解析服务（parse-video-py 容器）────────────────────────────
PARSE_BASE_URL=http://parse:8000
ALLOWED_DOMAINS=x.com,twitter.com,t.co
# 可选：解析服务走代理，如 http://127.0.0.1:7890
PARSE_VIDEO_PROXY=

# ── Google Drive ────────────────────────────────────────────
RCLONE_REMOTE=gdrive
DRIVE_ROOT=X-Drive
# 宿主机 rclone.conf 路径（绝对路径），挂载进容器只读
RCLONE_CONFIG_HOST=/vol1/@appshare/Harness/.config/rclone/rclone.conf
RCLONE_CONFIG=/config/rclone/rclone.conf

# ── 行为 ────────────────────────────────────────────────────
MAX_FILE_MB=500
CONCURRENCY=2
STATE_PATH=/data/state.json
TMP_ROOT=/downloads
TZ=Asia/Shanghai
