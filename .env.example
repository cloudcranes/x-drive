# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 Telegram user id；留空 = 拒绝所有人
ALLOWED_USER_IDS=

# ── aria2（p3terx/aria2-pro 容器）─────────────────────────────
# RPC 密钥，bot 通过它下发磁力任务；务必改成自己的随机串
ARIA2_RPC_SECRET=change-me-please
# BT 监听端口（需要在防火墙/路由器放行，否则做种少、速度慢）
LISTEN_PORT=6888
# 磁盘缓存，内存充裕可加大
ARIA2_DISK_CACHE=256M
# 容器内用户，root 默认 0
PUID=0
PGID=0

# bot 连接的 RPC 地址（compose 内网，一般不用改）
ARIA2_RPC=http://aria2:6800
# AriaNg Web 管理界面端口（宿主机）
ARIANG_PORT=6880

# ── 下载 ────────────────────────────────────────────────────
# 单个直链大小上限（MB）
MAX_FILE_MB=8192
# 磁力下载超时（秒）
# 单个任务的总超时（秒），兜底用
MAGNET_TIMEOUT=7200
# 连续多久没有任何新字节就判定死种并放弃（秒），0 = 不检测
# 实测正常种子几十秒内就会有进展，死种会一直挂到总超时
STALL_TIMEOUT=900
# 同时处理的任务数
CONCURRENCY=2

# ── Google Drive ────────────────────────────────────────────
RCLONE_REMOTE=gdrive
DRIVE_ROOT=X-Drive
# 宿主机 rclone.conf 路径（绝对路径），挂载进容器只读
RCLONE_CONFIG_HOST=/root/.config/rclone/rclone.conf
RCLONE_CONFIG=/config/rclone/rclone.conf
# 单日上传上限（GB），0 = 不限
DAILY_UPLOAD_GB=0

# ── 镜像 ────────────────────────────────────────────────────
# 用 Actions 构建好的镜像部署时取消注释（此时无需本机构建）
# BOT_IMAGE=ghcr.io/cloudcranes/x-drive:latest

# ── 看板 ────────────────────────────────────────────────────
WEB_PORT=8080
# 公网展示时填 用户名:密码，留空=不认证
WEB_AUTH=

# ── 运行时 ──────────────────────────────────────────────────
STATE_PATH=/data/state.json
# 未完成/失败的任务会落在这里，重启后自动补跑
PENDING_DIR=/data/pending
# 运行指标（成功/失败分类）
METRICS_PATH=/data/metrics.json
TMP_ROOT=/downloads
TZ=Asia/Shanghai

# ── 上传与重试（参数默认值来自实测，见 README「性能基线」）────────────
# 上传并发数：实测 4 比 2 快约 46%，8 反而更慢
UPLOAD_TRANSFERS=4
UPLOAD_CHUNK=64M
# 失败自动重试次数（不含首次），退避 3s→6s→12s 封顶 60s
RETRIES=2
RETRY_BASE_DELAY=3
