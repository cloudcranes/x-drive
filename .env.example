# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 Telegram user id；留空 = 拒绝所有人。先给 bot 发条消息即可看到自己的 id
ALLOWED_USER_IDS=

# ── 解析服务（parse-video-py 容器）────────────────────────────
PARSE_BASE_URL=http://parse:8000
ALLOWED_DOMAINS=x.com,twitter.com,t.co
# 可选：解析服务走代理，如 http://127.0.0.1:7890
PARSE_VIDEO_PROXY=

# ── Google Drive ────────────────────────────────────────────
RCLONE_REMOTE=gdrive
DRIVE_ROOT=X-Drive
# 宿主机 rclone.conf 路径（绝对路径），挂载进容器只读
RCLONE_CONFIG_HOST=/root/.config/rclone/rclone.conf
RCLONE_CONFIG=/config/rclone/rclone.conf

# ── 镜像 ────────────────────────────────────────────────────
# 用 Actions 构建好的镜像部署时取消注释（此时无需本机构建）
# BOT_IMAGE=ghcr.io/cloudcranes/x-drive:latest

# ── 展示页 ──────────────────────────────────────────────────
# 宿主机端口；容器内固定 8080
WEB_PORT=8080
# 公网展示时填 用户名:密码，留空=不认证
WEB_AUTH=

# ── 行为 ────────────────────────────────────────────────────
# auto=仅当视频是 High profile 才转 Main（老播放器兼容）；always=总是转；off=不转
VIDEO_TRANSCODE=auto
MAX_FILE_MB=500
CONCURRENCY=2
STATE_PATH=/data/state.json
# 未完成/部分失败的推文会落在这里，重启后自动补跑
PENDING_DIR=/data/pending
# 运行指标（成功/失败分类），展示页 /api/metrics 可读
METRICS_PATH=/data/metrics.json
# 单日上传上限（GB），0 = 不限制；超限时拒绝新任务并提示明天再试
DAILY_UPLOAD_GB=0
TMP_ROOT=/downloads
TZ=Asia/Shanghai
