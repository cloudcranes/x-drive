# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 Telegram user id；留空 = 拒绝所有人
ALLOWED_USER_IDS=

# ── 迅雷（cnk3x/xunlei 容器，外部已有，不归本 compose 管）────────────
# 面板地址。留空 = 走 compose 的默认值 host.docker.internal:2345（容器内访问宿主机）。
# 千万不要在这里写 127.0.0.1：容器里的 127.0.0.1 是容器自己，连不上迅雷面板。
# 只有「不走 compose、直接在宿主机上跑 python」时才填 http://127.0.0.1:2345
XUNLEI_URL=
# 下载目录 id 一般不用填：程序在真实 space 里按 RealPath == /downloads/ 自己找。
# 只有当迅雷里没有 /downloads 这个默认目录时才需要手填（面板新建任务请求体的 parent_folder_id）。
XUNLEI_PARENT_ID=
# 面板 token 一般不用填：首页 HTML 里的 uiauth 就是它，程序自己取。
# 只有面板版本低于 3.21 取不到时才需要手填一次。
XUNLEI_PAN_AUTH=
# 迅雷的下载目录在本机的位置。必须等于迅雷容器的 /downloads 挂载点，
# bot/web 会把它挂成自己的 /downloads（compose 里用这个变量）。
XUNLEI_DOWNLOADS_HOST=/vol2/@team/Downloads/action/xunlei
# 轮询间隔（秒）：看落盘判断进度，等太久显得迟钝，太快浪费 inotify
XUNLEI_POLL=10
# 文件静默多少秒算写完（秒）。迅雷没有「这个任务完了」的回调，只能看目录不动了
XUNLEI_SETTLE=30
# 面板里失败任务记录保留几天；0 = 不自动清（只在看板点「清理失败任务」时清）
PANEL_CLEAN_DAYS=0

# ── 下载 ────────────────────────────────────────────────────
# 单个直链大小上限（MB）
MAX_FILE_MB=8192
# 磁力下载超时（秒）
# 单个任务的总超时（秒），兜底用
MAGNET_TIMEOUT=7200
# 连续多久没有任何新字节就判定死种并放弃（秒），0 = 不检测
# 实测正常种子几十秒内就会有进展，死种会一直挂到总超时
STALL_TIMEOUT=900
# 同时处理的任务数
CONCURRENCY=2

# ── 存储后端 ────────────────────────────────────────────────
# 三选一：rclone（默认）/ openlist / clouddrive2。
# 切换之后**不需要重启**：网页「设置 → 存储」保存即生效（下一次上传走新后端）。
# 这里只是给「想在启动时就定好」的人用的兜底；网页里配过就以网页为准。
STORAGE_BACKEND=rclone
# 归档根目录。留空 = 用下面的 DRIVE_ROOT。OpenList/CD2 里收到的是虚拟路径（如 /X-Drive）
STORAGE_ROOT=
# OpenList（AList v3 兼容 REST）。密码同样建议在网页里填（只写不回显）
OPENLIST_URL=
OPENLIST_USER=admin
OPENLIST_PASSWORD=
# CloudDrive2（gRPC，默认与 Web 同端口 19798）
CD2_URL=
CD2_USER=
CD2_PASSWORD=

# ── Google Drive（仅 rclone 后端）────────────────────────────
RCLONE_REMOTE=gdrive
DRIVE_ROOT=X-Drive
# 宿主机 rclone.conf 路径（绝对路径），挂载进容器只读
RCLONE_CONFIG_HOST=/root/.config/rclone/rclone.conf
RCLONE_CONFIG=/config/rclone/rclone.conf
# 单日上传上限（GB），0 = 不限
DAILY_UPLOAD_GB=0

# ── 镜像 ────────────────────────────────────────────────────
# 用 Actions 构建好的镜像部署时取消注释（此时无需本机构建）
# BOT_IMAGE=ghcr.io/cloudcranes/x-drive:latest

# ── 看板 ────────────────────────────────────────────────────
WEB_PORT=8080
# 公网展示时填 用户名:密码，留空=不认证
WEB_AUTH=

# ── 运行时 ──────────────────────────────────────────────────
STATE_PATH=/data/state.json
# 未完成/失败的任务会落在这里，重启后自动补跑
PENDING_DIR=/data/pending
# 运行指标（成功/失败分类）
METRICS_PATH=/data/metrics.json
# 任务表（bot 与 web 共用；同番号只允许一个执行者）
JOBS_DB=/data/jobs.db
# 投递任务时迅雷在 /downloads 下建 <任务名>/ 目录，所以这里必须是 /downloads
TMP_ROOT=/downloads
# 整理工作区（改名/挑主体/上传都在这里做，不动迅雷下的原件）
STATE_DIR=/work
TZ=Asia/Shanghai

# ── 磁盘空间闸门（下载前检查剩余空间，不够就排队）─────────────────
# 永远给系统留这么多不参与分配。剩余空间 - 已在下的任务 - 预留 < 新任务 时排队。
DISK_RESERVE_GB=5
# 排队任务多久重新检查一次空间（秒，最小 5）
DISK_CHECK_INTERVAL=30
# 排队最久等多久（秒），0=一直等
DISK_QUEUE_TIMEOUT=0

# ── 上传与重试（参数默认值来自实测，见 README「性能基线」）────────────
# 上传并发数：实测 4 比 2 快约 46%，8 反而更慢
UPLOAD_TRANSFERS=4
UPLOAD_CHUNK=64M
# 失败自动重试次数（不含首次），退避 3s→6s→12s 封顶 60s
RETRIES=2
RETRY_BASE_DELAY=3

# ── 元数据（javdb / javbus）──────────────────────────────────
# 抓到的番号信息缓存到这里，一次抓取终身复用
META_PATH=/data/meta.json
# 演员/系列名 → javdb ID 的解析结果（订阅建议用），解析一次终身复用
IDS_PATH=/data/ids.json
# 两次外部请求的最小间隔（秒），避免把站点打疼
META_MIN_INTERVAL=1.5
# 优先用 javbus（JSON 接口，字段更全）；设为 0 只用 javdb
META_USE_JAVBUS=1

# ── 番号搜磁力（多源，先到先得）────────────────────────────────
# 逗号分隔，按顺序尝试；第一个有结果的源即采用。
# javbus 无 FC2 条目，FC2 番号自动只问 sukebei / bt4g。
SOURCES=javbus,sukebei,bt4g

# ── 订阅自动化 ──────────────────────────────────────────────
# 订阅存这里；后台按下面的间隔轮询
SUBS_PATH=/data/subs.json
# 订阅待办：发现到的作品先记这里，再按每轮上限逐轮提交
# 删掉它等于「重新认识一遍演员的作品列表」，不会重复下载已归档的番号
BACKLOG_PATH=/data/backlog.json
# 轮询间隔（秒），最小 300，默认 1 小时
SUBS_INTERVAL=3600

# ── 归档回收（默认关闭，需要时再开，避免误删）──────────────────
# 总容量上限（GB），0 = 不按容量淘汰
CLEANUP_MAX_GB=0
# 永远保留最近几个归档
CLEANUP_KEEP_RECENT=10
# 只考虑这么久之前的归档（天），0 = 不限
CLEANUP_OLDER_DAYS=0

# ── 刮削（MetaTube，用户自建服务；不归本 compose 管）──────────────────
# 后端地址。留空 = 不刮削，退回「只传视频」的老行为。
# 实测 v1.4.0：GET / 与 /v1/providers 无需鉴权；/v1/movies/* 需要 token。
METATUBE_URL=
# 访问密钥。只给后端用：不会进前端、日志、metadata.json 或导出包。
METATUBE_TOKEN=
# 服务端若不用 Bearer，改这两项即可，无需改代码
METATUBE_AUTH_HEADER=Authorization
METATUBE_AUTH_SCHEME=Bearer
# 本机直连该后端会超时（实测 TCP 都不通），走代理才能到。留空=直连
METATUBE_PROXY=
METATUBE_TIMEOUT=25
# 刮削结果缓存目录：同一番号不每轮都打外部服务，服务挂了也能用上次的数据
METATUBE_CACHE=/data/scrape
# 关掉就退回「只传视频」；SCRAPE_NFO / SCRAPE_POSTER 单独控制附件
SCRAPE=1
SCRAPE_NFO=1
SCRAPE_POSTER=1

# ── 通知（复用 Telegram）──────────────────────────────────────
TELEGRAM_CHAT_ID=
# 同一事件多久内不重复发（秒）：重试刷屏会把用户训练成忽略通知
NOTIFY_DEDUPE_WINDOW=1800
TELEGRAM_PROXY=

# ── 体积未知时的保守预留（GB）──────────────────────────────────
# 同系列也没历史时按这个估，避免「未知=不占盘」把磁盘写满
DEFAULT_SIZE_GB=4
